<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Single package source required when using Central Package Management (Directory.Packages.props).
      If your organisation uses a private feed (e.g. Artifactory, Azure Artifacts), replace the
      value below with that feed URL and remove the nuget.org entry, or add package source mapping.
      See: https://aka.ms/nuget-package-source-mapping
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
